{
  "name": "@kraki/tentacle",
  "version": "0.39.1",
  "description": "Kraki: chat with the coding agents on your computers (Claude Code, Codex, GitHub Copilot, Pi) from your phone, Mac or browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/corelli18512/kraki",
    "directory": "packages/tentacle"
  },
  "homepage": "https://kraki.chat",
  "keywords": [
    "kraki",
    "claude-code",
    "codex",
    "copilot",
    "coding-agent",
    "ai-agents",
    "remote-control",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/corelli18512/kraki/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kraki": "dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "dev:local": "KRAKI_APP_URL=http://localhost:3000 node dist/cli.js",
    "build": "node ./scripts/build.mjs",
    "build:binary:local": "node ./scripts/build-local-binary.mjs",
    "clean": "node ./scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.156",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@github/copilot-sdk": "^1.0.1",
    "@inquirer/prompts": "^8.3.2",
    "@kraki/crypto": "workspace:*",
    "@kraki/protocol": "workspace:*",
    "@kraki/pulse": "workspace:*",
    "chalk": "^5.6.2",
    "https-proxy-agent": "^9.1.0",
    "minimatch": "10.2.6",
    "ora": "^9.3.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.27.4",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
