{
  "name": "@kraki/crypto",
  "version": "0.2.4",
  "description": "Kraki encryption: X25519/HKDF/AES-GCM, Ed25519 and legacy RSA compatibility",
  "repository": {
    "type": "git",
    "url": "https://github.com/corelli18512/kraki",
    "directory": "packages/crypto"
  },
  "homepage": "https://github.com/corelli18512/kraki/tree/main/packages/crypto#readme",
  "bugs": {
    "url": "https://github.com/corelli18512/kraki/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./web": { "types": "./dist/web/index.d.ts", "default": "./dist/web/index.js" }
  },
  "files": ["dist", "LICENSE.coinfra"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:swift": "swift test --package-path SwiftCrypto",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
