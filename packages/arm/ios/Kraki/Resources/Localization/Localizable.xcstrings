    },
    "Kraki could not verify the saved connection. Update Kraki on this computer first. Only reset if you changed or reinstalled it; otherwise keep the saved keys and investigate." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraki 无法验证已保存的连接。请先在这台电脑上更新 Kraki。仅在你更改或重新安装了 Kraki 时重置；否则请保留已保存的密钥并排查原因。"
          }
        }
      }
    },
    "Kraki couldn't run on this Mac" : {
      "localizations" : {
