# Kraki Relay — Environment Configuration
# Copy to .env and fill in your values.

# Auth mode: open | github | apikey (default: open)
# AUTH_MODE=github

# GitHub OAuth App credentials (required for "Sign in with GitHub" on the web app)
# Create one at: GitHub → Settings → Developer settings → OAuth Apps → New
# Set the Authorization callback URL to the root of your web app
# (e.g. http://localhost:3000) — the SPA redirects users to its
# /auth/callback subpath, which is automatically a valid subpath of
# the registered root.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# API key for apikey auth mode
# API_KEY=

# Voice input (optional). VOICE_LEASE_ENABLED, VOICE_BROKER_URL and
# VOICE_SETTLEMENT_KEY must be set together; the quota/TTL have defaults.
# VOICE_LEASE_ENABLED=1
# VOICE_BROKER_URL=wss://stt.example.com/voice
# Max seconds of voice input per user per UTC day (the only voice limit)
# VOICE_DAILY_QUOTA_SEC=7200
# VOICE_LEASE_TTL_SEC=86400
# Shared only with the regional voice broker. Generate with: openssl rand -hex 32
# VOICE_SETTLEMENT_KEY=

# Server settings
# PORT=4000
# DB_PATH=kraki-head.db
# PAIRING_ENABLED=true
# LOG_LEVEL=info
# LOG_PATH=

# Admin stats endpoint (GET /admin/stats). Prefer the env var over the
# --admin-key flag, which is visible to other users in `ps`.
# ADMIN_KEY=
