#!/usr/bin/python3
# Only command allowed by the dedicated peer SSH key. Never a general shell.
import pathlib
import sys
try:
    data = pathlib.Path('/var/lib/kraki-insights/export.json').read_bytes()
    if len(data) > 16 * 1024 * 1024: raise ValueError('export too large')
    sys.stdout.buffer.write(data)
except Exception:
    sys.exit(1)
