[Unit]
Description=Kraki read-only product and client experience statistics
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/kraki-insights/run.py
TimeoutStartSec=45
UMask=0077
Nice=15
CPUWeight=10
CPUQuota=20%
MemoryMax=192M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kraki-insights
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
