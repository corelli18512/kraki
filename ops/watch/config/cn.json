{
  "host": "cn",
  "label": "China",
  "timezone": "Asia/Shanghai",
  "quietHours": [23, 8],
  "digestHour": 9,
  "relayUnit": "kraki-relay",
  "metricsUrl": "http://127.0.0.1:4000/internal/metrics",
  "backupStatus": "/var/lib/kraki-watch/backup.json",
  "insightsPath": "/var/lib/kraki-insights/summary.json",
  "experienceNotify": false,
  "disk": { "path": "/", "warning": 85, "critical": 95 },
  "units": [
    { "unit": "kraki-bark", "name": "China Bark service", "severity": "critical" },
    { "unit": "kraki-relay", "name": "China relay process", "severity": "critical" },
    { "unit": "nginx", "name": "nginx (China reverse proxy)", "severity": "critical" },
    { "unit": "kraki-voice-broker", "id": "K-VOICE-DOWN@unit", "name": "Voice gateway process", "severity": "critical" },
    { "unit": "kraki-diag", "id": "K-DIAG-DOWN", "name": "China diagnostics service", "severity": "warning" }
  ],
  "probes": [
    { "id": "K-BARK-DOWN", "target": "cn", "name": "China Bark local endpoint", "url": "http://127.0.0.1:4080/bark/ping", "expectBody": "\"message\":\"pong\"", "severity": "critical", "failAfter": 3, "local": true },
    { "id": "K-BARK-PEER", "target": "tokyo", "name": "Tokyo Bark (from China)", "url": "https://relay.kraki.chat/bark/ping", "expectBody": "\"message\":\"pong\"", "severity": "critical", "failAfter": 5, "timeoutMs": 15000 },
    { "id": "K-RELAY-DOWN", "target": "cn", "name": "China relay", "url": "https://cn.relay.kraki.chat/", "expectBody": "\"status\":\"ok\"", "relay": true, "severity": "critical", "failAfter": 3, "local": true, "slow": true },
    { "id": "K-RELAY-WS", "target": "cn", "kind": "ws", "name": "China relay WebSocket", "url": "wss://cn.relay.kraki.chat/", "severity": "critical", "failAfter": 3, "local": true },
    { "id": "K-RELAY-READY", "target": "cn", "name": "China relay readiness", "url": "http://127.0.0.1:4000/health/ready", "expectBody": "\"status\":\"ready\"", "readiness": true, "severity": "critical", "failAfter": 3, "local": true },
    { "id": "K-VOICE-DOWN", "target": "cn-stt", "name": "Voice gateway (cn.stt.kraki.chat)", "url": "https://cn.stt.kraki.chat/healthz", "expectBody": "\"ok\":true", "severity": "critical", "failAfter": 3, "local": true },
    { "id": "K-DIAG-DOWN", "target": "cn-http", "name": "China diagnostics endpoint", "url": "http://127.0.0.1:4011/health", "expectBody": "kraki-diag", "severity": "warning", "failAfter": 5, "local": true },
    { "id": "K-PEER-DOWN", "target": "tokyo", "name": "Tokyo relay (from China)", "url": "https://relay.kraki.chat/", "expectBody": "\"status\":\"ok\"", "relay": true, "severity": "critical", "failAfter": 5, "timeoutMs": 15000 }
  ],
  "certs": ["cn.relay.kraki.chat", "cn.stt.kraki.chat", "stt.kraki.chat"]
}
