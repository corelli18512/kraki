{
  "host": "tokyo",
  "label": "Tokyo",
  "timezone": "Asia/Shanghai",
  "quietHours": [23, 8],
  "digestHour": 9,
  "relayUnit": "kraki-relay",
  "metricsUrl": "http://127.0.0.1:4000/internal/metrics",
  "backupStatus": "/var/lib/kraki-watch/backup.json",
  "insightsPath": "/var/lib/kraki-insights/summary.json",
  "experienceNotify": false,
  "disk": { "path": "/", "warning": 85, "critical": 95 },
  "units": [
    { "unit": "kraki-bark", "name": "Tokyo Bark service", "severity": "critical" },
    { "unit": "kraki-relay", "name": "Tokyo relay process", "severity": "critical" },
    { "unit": "caddy", "name": "Caddy (Tokyo reverse proxy)", "severity": "critical" },
    { "unit": "kraki-diag", "id": "K-DIAG-DOWN", "name": "Tokyo diagnostics service", "severity": "warning" }
  ],
  "probes": [
    { "id": "K-BARK-DOWN", "target": "tokyo", "name": "Tokyo Bark local endpoint", "url": "http://127.0.0.1:4080/bark/ping", "expectBody": "\"message\":\"pong\"", "severity": "critical", "failAfter": 3, "local": true },
    { "id": "K-BARK-PEER", "target": "cn", "name": "China Bark (from Tokyo)", "url": "https://cn.relay.kraki.chat/bark/ping", "expectBody": "\"message\":\"pong\"", "severity": "critical", "failAfter": 5, "timeoutMs": 15000 },
    { "id": "K-RELAY-DOWN", "target": "tokyo", "name": "Tokyo relay", "url": "https://relay.kraki.chat/", "expectBody": "\"status\":\"ok\"", "relay": true, "severity": "critical", "failAfter": 3, "local": true, "slow": true },
    { "id": "K-RELAY-WS", "target": "tokyo", "kind": "ws", "name": "Tokyo relay WebSocket", "url": "wss://relay.kraki.chat/", "severity": "critical", "failAfter": 3, "local": true },
    { "id": "K-RELAY-READY", "target": "tokyo", "name": "Tokyo relay readiness", "url": "http://127.0.0.1:4000/health/ready", "expectBody": "\"status\":\"ready\"", "readiness": true, "severity": "critical", "failAfter": 3, "local": true },
    { "id": "K-PEER-DOWN", "target": "cn", "name": "China relay (from Tokyo)", "url": "https://cn.relay.kraki.chat/", "expectBody": "\"status\":\"ok\"", "relay": true, "severity": "critical", "failAfter": 5, "timeoutMs": 15000 },
    { "id": "K-WEB-DOWN", "target": "web", "name": "Web app", "url": "https://app.kraki.chat/", "severity": "critical", "failAfter": 3 },
    { "id": "K-SITE-DOWN", "target": "site", "name": "Website", "url": "https://kraki.chat/", "severity": "warning", "failAfter": 5 },
    { "id": "K-SITE-DOWN", "target": "dl-mac", "name": "Mac download link", "url": "https://kraki.chat/download/mac", "expectRedirect": "/releases/download/mac-v[^/]+/Kraki\\.dmg$", "severity": "warning", "failAfter": 5 },
    { "id": "K-SITE-DOWN", "target": "dl-win", "name": "Windows download link", "url": "https://kraki.chat/download/windows", "expectRedirect": "/releases/download/win-v[^/]+/.+\\.exe$", "severity": "warning", "failAfter": 5 },
    { "id": "K-VOICE-DOWN", "target": "stt", "name": "Voice gateway (stt.kraki.chat)", "url": "https://stt.kraki.chat/healthz", "expectBody": "\"ok\":true", "severity": "critical", "failAfter": 5, "timeoutMs": 15000 }
  ],
  "certs": ["relay.kraki.chat", "app.kraki.chat", "kraki.chat"]
}
