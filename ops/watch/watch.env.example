# /etc/kraki/watch.env (root, mode 600). Never commit real values.
# Copy only the key from Bark's URL, not the whole URL. Required when NOTIFY=1.
BARK_KEY=
# HTTPS base URL; HTTP is accepted only on loopback for local tests.
BARK_SERVER=https://api.day.app
# One secret ping URL per host; configure an independent email integration too.
HC_PING_URL=
# Validate with `kraki-watch check-config` (offline, no messages).
# 0 = shadow mode (log what would be sent), 1 = send to Bark.
KRAKI_WATCH_NOTIFY=0
# Optional independent digest delivery. Leave 0 during installation; with
# explicit approval, set 1 to receive the passive 09:00 digest while alerts stay off.
KRAKI_WATCH_DIGEST_NOTIFY=0
KRAKI_WATCH_CONFIG=/etc/kraki/watch.json
# Backup (backup-relay-db.sh)
KRAKI_DB=
KRAKI_BACKUP_DIR=/var/backups/kraki-relay
# Off-site copy: user@host:dir on the other relay (ssh key in /root/.ssh/kraki-backup)
KRAKI_BACKUP_REMOTE=
