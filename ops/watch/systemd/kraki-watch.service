[Unit]
Description=Kraki alerting check (kraki-watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/kraki/watch.env
ExecStart=/opt/kraki-watch/node /opt/kraki-watch/kraki-watch.mjs
TimeoutStartSec=50
# Needs journalctl and systemctl (read-only), nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/kraki-watch
PrivateTmp=yes
